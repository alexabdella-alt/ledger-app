# Supabase — set these in Vercel (Project → Settings → Environment Variables)
# and in a local .env for dev. The anon key is public by design (RLS is the
# real boundary), but keeping it in env lets you point at staging vs prod.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry error monitoring (optional). Without VITE_SENTRY_DSN, Sentry is a no-op.
VITE_SENTRY_DSN=

# Source-map upload to Sentry (optional, build-time only). Leave unset for local
# builds — the Vite plugin is skipped entirely without SENTRY_AUTH_TOKEN.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
